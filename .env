# Copy to .env and fill in. .env is git-ignored.
#
# Host UID/GID — keeps bind-mounted files owned by you, not by container root.
# Run `id -u` and `id -g` if unsure.
UID=0
GID=0

# Authentication. Either set an API key, OR leave empty and use the persisted
# OAuth login from the `claude-code-config` named volume.
#ANTHROPIC_API_KEY=sk-ant-...

PROJECT_DIR=/home/thomas/workspace/code/open_resource/GitNexus
ORACLE_INSTANT_DIR=/usr/lib/oracle/21/client64/lib
NODE_HOME=/home/thomas
