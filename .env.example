# =============================================================================
# Claude Code Portal - 所有可配置项
# =============================================================================
# 复制此文件为 .env，按需修改。改动后 portal 重启生效（`docker compose up -d`）。
# 标 ⚠️ 的是改了需要 rebuild 镜像的项；其他都是纯 runtime。
# =============================================================================

# -----------------------------------------------------------------------------
# Portal HTTP 端口（用户浏览器访问的端口）
# -----------------------------------------------------------------------------
# 宿主机上 portal 监听的端口
PORTAL_HOST_PORT=9900
# portal 容器内 gunicorn 绑定的端口
# ⚠️ 改了要 rebuild portal 镜像：`docker compose build portal`
PORTAL_CONTAINER_PORT=9900

# -----------------------------------------------------------------------------
# Claude 容器端口范围（host 视角，每个用户分一个）
# -----------------------------------------------------------------------------
CLAUDE_PORT_MIN=9901
CLAUDE_PORT_MAX=9999

# 活跃容器总数上限。0 = 不限（默认）；正数 N = 超过 N 个 running 容器时
# 拒绝新的 start / rebuild 请求（429 + code=MAX_ACTIVE_REACHED）。
MAX_ACTIVE_CONTAINERS=0

# -----------------------------------------------------------------------------
# Claude 镜像标签（portal docker.run 时拉哪个 tag）
# -----------------------------------------------------------------------------
CLAUDE_IMAGE_NAME=claude-code:local

# -----------------------------------------------------------------------------
# Portal 容器 / claude 容器标签（管理用）
# -----------------------------------------------------------------------------
PORTAL_LABEL=managed-by

# -----------------------------------------------------------------------------
# 宿主机上的路径（portal 通过这些路径读取 volumes 内容、传给 docker.run）
# -----------------------------------------------------------------------------
# 项目根目录（默认值是当前开发机路径，生产环境请改成实际位置）
HOST_PROJECT_DIR=/home/thomas/workspace/code/claude_web_images
# 容器内 volumes 总目录（下面挂 users / code / node / certs 四个子目录）
HOST_VOLUMES_DIR=${HOST_PROJECT_DIR}/volumes
HOST_USERS_DIR=${HOST_VOLUMES_DIR}/users
HOST_CODE_DIR=${HOST_VOLUMES_DIR}/code
HOST_TEMPLATE_DIR=${HOST_VOLUMES_DIR}/node
HOST_CERTS_DIR=${HOST_VOLUMES_DIR}/certs
# Docker socket（macOS / 自定义 docker 路径场景可改）
HOST_DOCKER_SOCK=/var/run/docker.sock

# -----------------------------------------------------------------------------
# Portal 容器内 mount point（./volumes:/volumes 的右侧）
# -----------------------------------------------------------------------------
PORTAL_VOLUMES_MOUNT=/volumes

# -----------------------------------------------------------------------------
# ⚠️ Claude 容器内 bind target（改这些要 rebuild claude-code 镜像）
# -----------------------------------------------------------------------------
# 默认值匹配 v4.129.0 镜像；改完要 `docker build . -t claude-code:local`
CLAUDE_WORKSPACE_BIND=/workspace
CLAUDE_HOME_BIND=/home/node
CLAUDE_SCRATCH_BIND=/home/node/scratch
CLAUDE_CERT_DIR_BIND=/etc/code-server
CLAUDE_INTERNAL_PORT=8080

# -----------------------------------------------------------------------------
# 文件名 / 子目录名（一般不需要改；极端定制场景）
# -----------------------------------------------------------------------------
USERS_CACHE_FILENAME=.portal_users.json
CERT_DIR_NAME=code-server-certs
CA_CERT_FILENAME=ca.crt
CA_KEY_FILENAME=ca.key
CLAUDE_CERT_FILENAME=cert.pem
CLAUDE_KEY_FILENAME=key.pem
SCRATCH_DIR_NAME=scratch
WORKSPACE_FILE_NAME=workspace.code-workspace
SAN_CONFIG_NAME=san.cnf
CSR_FILENAME=cert.csr

# -----------------------------------------------------------------------------
# 管理员面板（/admin 路由 + /api/admin/* API）
# -----------------------------------------------------------------------------
# 管理员密码：用于登录 /admin 页面的独立密码（不要与 per-user 密码混用）
# 留空或注释掉 → 整个 admin 路由直接 404（关掉管理面板）
ADMIN_PASSWORD=
# Flask session 签名密钥。
#   ⚠️ 必须显式设！gunicorn 多 worker 下，不设会让每个 worker 各自生成随机 key
#      → cookie 在 worker 之间不互通 → 登录后随机 401。
#   不设也行 —— portal 会从 HOST_PROJECT_DIR 派生一个稳定的 key（够用，但 cookie 跨
#   部署目录迁移会失效）。生产建议显式设一个 32+ 字符的随机串：
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET=
# Admin session 有效期（秒）。默认 8h。过期需要重新登录。
ADMIN_SESSION_MAX_AGE=28800